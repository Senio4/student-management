<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar">
        <div class="container">
            <h1>Student Management System</h1>
            <a href="/">Student List</a>
        </div>
    </nav>

    <main class="container">

        <div class="page-header">
            <h2>Add Student</h2>
        </div>

        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
        <% } %>

        <form action="/add" method="POST" class="student-form">

            <label>Student ID</label>
            <input
                type="text"
                name="student_id"
                placeholder="2026-0099"
                required
            >

            <label>First Name</label>
            <input
                type="text"
                name="first_name"
                required
            >

            <label>Last Name</label>
            <input
                type="text"
                name="last_name"
                required
            >

            <label>Course</label>
            <input
                type="text"
                name="course"
                placeholder="BS Information Technology"
                required
            >

            <label>Year Level</label>
            <input
                type="number"
                name="year_level"
                min="1"
                max="4"
                required
            >

            <label>Email</label>
            <input
                type="email"
                name="email"
                placeholder="john@example.com"
                required
            >

            <div class="form-actions">

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Save Student
                </button>

                <a
                    href="/"
                    class="btn btn-secondary"
                >
                    Cancel
                </a>

            </div>

        </form>

    </main>

</body>
</html>
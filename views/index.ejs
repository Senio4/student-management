<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="topbar">
            <h1>Student Management System</h1>
            <nav>
                <a href="/" class="nav-button">Student List</a>
                <a href="/students/add" class="nav-button primary">Add Student</a>
            </nav>
        </header>

        <main class="panel">
            <div class="toolbar">
                <h2>Student List</h2>
                <form action="/" method="GET" class="search-form">
                    <input type="text" name="keyword" value="<%= keyword || '' %>" placeholder="Search student...">
                    <button type="submit">Search</button>
                    <% if (keyword) { %>
                        <a href="/" class="clear-link">Clear</a>
                    <% } %>
                </form>
            </div>

            <% if (students && students.length > 0) { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Student ID</th>
                                <th>Name</th>
                                <th>Course</th>
                                <th>Year</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(student => { %>
                                <tr>
                                    <td><%= student.id %></td>
                                    <td><%= student.student_id %></td>
                                    <td><%= student.first_name %> <%= student.last_name %></td>
                                    <td><%= student.course %></td>
                                    <td><%= student.year_level %></td>
                                    <td><%= student.email %></td>
                                    <td class="actions">
                                        <a href="/students/edit/<%= student.id %>" class="action-link edit">Edit</a>
                                        <form action="/students/delete/<%= student.id %>" method="POST" onsubmit="return confirm('Delete this student?')">
                                            <button type="submit" class="action-link delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="empty-state">No students found.</p>
            <% } %>
        </main>
    </div>
</body>
</html>
